# PostgreSQL connection from Neon or Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Paystack (NGN; use test keys locally)
PAYSTACK_SECRET_KEY="sk_test_replace-me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace-me"

# Resend email delivery
RESEND_API_KEY="re_replace-me"
EMAIL_FROM="Adetech Solar <orders@example.com>"
ADMIN_EMAIL="hello@example.com"

# Public deployment URL, e.g. https://adetech.ng
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
